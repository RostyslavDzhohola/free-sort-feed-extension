{
  "name": "outliers-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:extension": "pnpm --filter @outliers/extension run build",
    "watch:extension": "pnpm --filter @outliers/extension run watch",
    "dev:web": "pnpm --filter @outliers/website run dev",
    "build:web": "pnpm --filter @outliers/website run build",
    "preview:web": "pnpm --filter @outliers/website run preview",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  }
}

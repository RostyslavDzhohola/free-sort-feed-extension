---
import "./pin.css";

interface Props {
  n: number;
  /** Interactive pin: a focusable button that shows hint `n` (used inside the demo panel). */
  hint?: boolean;
  label?: string;
}

const { n, hint = false, label } = Astro.props;
---

{
  hint ? (
    <button class="pin" type="button" data-hint={n} aria-label={`Hint ${n}: ${label ?? ""}`} aria-describedby={`demo-hint-${n}`}>
      {n}
    </button>
  ) : (
    <span class="pin" aria-hidden="true">
      {n}
    </span>
  )
}

---
// Illustration of the v1.0.7 side panel. Visual only: all content comes from `data`.
// See ./types.ts for the zone contract the tour relies on.
import icon128 from "../../assets/icon-128.png";
import Pin from "./Pin.astro";
import type { PanelIllustrationData } from "./types";
import "./panel-illustration.css";

interface Props {
  data: PanelIllustrationData;
}

const { data } = Astro.props;
const fill = (data.scanLimit.position * 100).toFixed(1) + "%";
---

<div class="sp" role="img" aria-label={data.alt}>
  <div class="sp-head">
    <div><b>{data.title}</b><small>{data.tagline}</small></div>
    <img src={icon128.src} alt="" width="40" height="40" />
  </div>
  <div class="sp-switch">{data.tabs.map((t) => <span class:list={{ on: t.active }}>{t.label}</span>)}</div>
  <div class="sp-zone" data-zone="1">
    <div class="sp-stats"><span>{data.threshold.label}</span><b>{data.threshold.value}</b></div>
    <Pin n={1} />
  </div>
  <div class="sp-zone" data-zone="2">
    <div class="sp-ctl"><span>{data.scanLimit.label}</span><b>{data.scanLimit.value}</b></div>
    <div class="sp-slider"><i style={`width: ${fill}`}></i><em style={`left: ${fill}`}></em></div>
    <Pin n={2} />
  </div>
  <div class="sp-zone" data-zone="3">
    <div class="sp-ctl"><span>{data.filterMode.label}</span></div>
    <div class="sp-modes">{data.filterMode.options.map((o) => <span class:list={{ on: o.active }}>{o.label}</span>)}</div>
    <Pin n={3} />
  </div>
  <div class="sp-run">{data.actionLabel}</div>
  <div class="sp-results">
    <div class="sp-results-head">
      <span>{data.results.title} <small>{data.results.summary}</small></span>
      <span class="sp-zone sp-zone-inline" data-zone="5">
        {data.results.tools.map((tool) => <span class="sp-tool">{tool}</span>)}
        <Pin n={5} />
      </span>
    </div>
    <div class="sp-zone" data-zone="4">
      <ol class="sp-list">
        {
          data.results.rows.map((row) => (
            <li>
              <span class="r">#{row.rank}</span>
              <span class="i">
                <span class="v">{row.views}</span>
                <span class="x">{row.ratio}</span>
              </span>
              <span class="a">{data.results.rowActions.map((action) => <span>{action}</span>)}</span>
            </li>
          ))
        }
      </ol>
      <Pin n={4} />
    </div>
  </div>
</div>

---
// Chapter III: the annotated side panel (DESIGN-SPEC §6.3). The illustration comes from ../panel,
// so it can be swapped for the redesigned panel without touching this section.
import Chapter from "../Chapter.astro";
import Pin from "../panel/Pin.astro";
import { PanelIllustration, panelNotes, samplePanel } from "../panel";
import "./tour.css";
---

<section class="section" id="tour" aria-labelledby="tour-title">
  <div class="wrap">
    <Chapter numeral="III." kicker="The side panel, annotated" title="Everything lives in one panel." id="tour-title" />
    <div class="tour" data-tour>
      <figure class="tour-shot">
        <PanelIllustration data={samplePanel} />
        <figcaption class="tour-caption">{samplePanel.caption}</figcaption>
      </figure>
      <ol class="notes">
        {
          panelNotes.map((note, i) => (
            <li data-note={note.zone} tabindex="0" class:list={{ active: i === 0 }}>
              <Pin n={note.zone} />
              <div>
                <h3>{note.title}</h3>
                <p set:html={note.body} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from "../../lib/motion";

  const tour = document.querySelector<HTMLElement>("[data-tour]");
  if (tour) {
    const notes = Array.from(tour.querySelectorAll<HTMLElement>("[data-note]"));
    const zones = Array.from(tour.querySelectorAll<HTMLElement>("[data-zone]"));
    const CYCLE_MS = 2600;
    let timer = 0;
    let index = 0;
    let userInteracted = false;

    const activate = (id: string) => {
      notes.forEach((n) => n.classList.toggle("active", n.dataset.note === id));
      zones.forEach((z) => z.classList.toggle("active", z.dataset.zone === id));
      index = Math.max(0, notes.findIndex((n) => n.dataset.note === id));
    };

    const stopCycle = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    // Auto-cycling ends for good the moment the reader engages with the tour.
    const engage = () => {
      userInteracted = true;
      stopCycle();
    };

    for (const note of notes) {
      const on = () => {
        engage();
        activate(note.dataset.note!);
      };
      note.addEventListener("pointerenter", on);
      note.addEventListener("focus", on);
    }
    for (const zone of zones) {
      zone.addEventListener("pointerenter", () => {
        engage();
        activate(zone.dataset.zone!);
      });
    }
    tour.addEventListener("pointerdown", engage);

    activate(notes[0]?.dataset.note ?? "1");

    if (!prefersReducedMotion() && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((e) => e.isIntersecting);
          if (visible && !timer && !userInteracted) {
            timer = window.setInterval(() => {
              const next = notes[(index + 1) % notes.length];
              if (next) activate(next.dataset.note!);
            }, CYCLE_MS);
          } else if (!visible) {
            stopCycle();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(tour);
    }
  }
</script>

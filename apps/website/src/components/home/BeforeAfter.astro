---
// Before/after compare (DESIGN-SPEC §6.1), drawn from a demo snapshot (data/demo/profiles.ts → heroProfile).
// Both grids are rendered here; the island only moves the divider.
import { findOutliers } from "@outliers/core";
import { heroProfile } from "../../data/demo/profiles";
import { initialsFor } from "../../data/demo/initials";
import { tileHtml } from "../../lib/demo-render";
import "../../styles/tiles.css";
import "./before-after.css";

const { snapshot, assetBase, kind, capturedLabel } = heroProfile;
const run = findOutliers(snapshot.reels, { mode: "ratio5x", followers: snapshot.followers });
const before = snapshot.reels.slice(0, 9);
const after = run.outliers.slice(0, 6);
// Circle the #3 multiple: it sits in view at the resting 50% position.
const circled = Math.min(2, after.length - 1);
const summary = `${run.outliers.length} of ${run.scannedCount} reels • ${run.thresholdLabel}`;
// Grid position drives each tile's cover colours; ranked results are copies, so look them up by URL.
const gridIndex = new Map(snapshot.reels.map((reel, i) => [reel.url, i]));
const beforeHtml = before.map((reel, i) => tileHtml(reel, i, assetBase)).join("");
const afterHtml = after
  .map((reel, i) => tileHtml(reel, gridIndex.get(reel.url) ?? i, assetBase, { rank: i + 1, ratio: reel.ratio, circled: i === circled }))
  .join("");
const sourceNote = kind === "sample" ? "sample data from a fictional profile" : `real snapshot of @${snapshot.handle}, captured ${capturedLabel}`;
---

<figure class="hero-figure">
  <div class="ba" data-ba style="--pos: 50%">
    <div class="ba-layer ba-before" aria-hidden="true">
      <div class="ig-head">
        <span class="ig-av">{initialsFor(snapshot.handle)}</span>
        <div><b>{snapshot.handle}</b><small>{snapshot.followersText} followers</small></div>
      </div>
      <div class="ig-tabs"><span>Posts</span><span class="on">Reels</span><span>Tagged</span></div>
      <div class="ba-grid" set:html={beforeHtml} />
    </div>
    <div class="ba-layer ba-after" aria-hidden="true">
      <div class="og-head">
        <b>Outliers</b>
        <small>{summary}</small>
      </div>
      <div class="ba-grid ba-grid-after" set:html={afterHtml} />
    </div>
    <div class="ba-handle" aria-hidden="true"><span>‹ ›</span></div>
    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Drag to compare Instagram's grid with the Outliers grid"
      aria-valuetext="50% of the Outliers grid showing"
      data-ba-range
    />
  </div>
  <figcaption>
    <span class="cap-l"><i>Before</i> · Instagram, newest first</span>
    <span class="cap-r"><i>After</i> · Outliers, biggest first</span>
  </figcaption>
  <p class="sample-note">Drag the handle · {sourceNote}</p>
</figure>

<script>
  import { prefersReducedMotion } from "../../lib/motion";

  const ba = document.querySelector<HTMLElement>("[data-ba]");
  const range = ba?.querySelector<HTMLInputElement>("[data-ba-range]");

  if (ba && range) {
    let userTouched = false;

    const setPos = (value: number) => {
      ba.style.setProperty("--pos", value.toFixed(2) + "%");
      range.setAttribute("aria-valuetext", Math.round(100 - value) + "% of the Outliers grid showing");
    };

    const takeOver = () => {
      userTouched = true;
    };
    range.addEventListener("input", () => {
      takeOver();
      setPos(Number(range.value));
    });
    range.addEventListener("pointerdown", takeOver);
    range.addEventListener("keydown", takeOver);

    // One sweep (50 → 82 → 18 → 50 over 2.4s) to show the card is interactive. Any input cancels it.
    const KEYS: ReadonlyArray<readonly [number, number]> = [[0, 50], [700, 82], [1600, 18], [2400, 50]];
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    const sweep = () => {
      const start = performance.now();
      const frame = (now: number) => {
        if (userTouched) return;
        const t = now - start;
        let k = 0;
        while (k < KEYS.length - 2 && t > KEYS[k + 1]![0]) k++;
        const [t0, v0] = KEYS[k]!;
        const [t1, v1] = KEYS[k + 1]!;
        const p = Math.min(1, Math.max(0, (t - t0) / (t1 - t0)));
        const v = v0 + (v1 - v0) * ease(p);
        setPos(v);
        range.value = String(Math.round(v));
        if (t < KEYS[KEYS.length - 1]![0]) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };

    const intro = () => {
      ba.classList.add("drawn");
      if (!prefersReducedMotion() && !userTouched) sweep();
    };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            window.setTimeout(intro, 500);
          }
        },
        { threshold: 0.5 }
      );
      io.observe(ba);
    } else {
      intro();
    }
  }
</script>

---
import Chapter from "../Chapter.astro";
import "./uses.css";

const uses = [
  { title: "Study a competitor", body: "Scan a peer's Reels tab and see which of their videos travelled furthest relative to their audience." },
  { title: "Find formats that travel", body: "Line up the outliers from a few creators in your niche and look for repeated hooks, lengths and formats." },
  { title: "Audit your own account", body: "Run it on your profile to find the Reels worth remaking, extending or turning into a series." },
  { title: "Report to a client", body: "Export a ranked CSV with links, views and multiples for a brief, a deck or a content calendar." },
];
---

<section class="section section-rule" id="uses" aria-labelledby="uses-title">
  <div class="wrap">
    <Chapter numeral="IV." kicker="Ways to use it" title="Made for research, not vanity." id="uses-title" tight />
    <div class="uses">
      {
        uses.map((use) => (
          <article>
            <h3>{use.title}</h3>
            <p>{use.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
